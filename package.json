{
  "name": "weft-terminal",
  "version": "1.0.1",
  "description": "Weft Terminal — 串口 · 终端 · SSH",
  "main": "electron/main.js",
  "author": "Weft",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "postinstall": "node scripts/setup-native.cjs"
  },
  "dependencies": {
    "@splinetool/react-spline": "^4.2.0",
    "@splinetool/runtime": "^2.0.203",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/xterm": "^5.5.0",
    "iconv-lite": "^0.6.3",
    "node-pty": "^1.1.0",
    "serialport": "^12.0.0",
    "ssh2": "^1.17.0",
    "systeminformation": "^5.33.23"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "24.8.8",
    "electron-builder": "^24.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.21",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.weftterminal.app",
    "productName": "Weft Terminal",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/@serialport/bindings-cpp/build/**",
      "!node_modules/node-pty/build/**"
    ],
    "asarUnpack": [
      "node_modules/serialport/**",
      "node_modules/@serialport/**",
      "node_modules/node-pty/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "npmRebuild": false,
    "afterPack": "scripts/after-pack.cjs",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Weft Terminal",
      "uninstallDisplayName": "Weft Terminal"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/910106845/Weft-Terminal.git"
  },
  "homepage": "https://github.com/910106845/Weft-Terminal",
  "bugs": {
    "url": "https://github.com/910106845/Weft-Terminal/issues"
  }
}
